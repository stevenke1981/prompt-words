# 任一供應商可由伺服器環境變數提供 Key；使用者也可在介面暫時輸入。
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Prompt Words

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Sakana Fugu API 可能依帳戶／Beta 文件提供不同端點，請填入實際 OpenAI-compatible Base URL。
SAKANA_API_KEY=
SAKANA_BASE_URL=
SAKANA_MODEL=fugu-ultra

# 其他 OpenAI-compatible 服務，可選。
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=

# SQLite 檔案位置與正式服務連接埠
PROMPT_WORDS_DB=./data/prompt-words.db
PORT=8787
